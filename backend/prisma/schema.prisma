generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMLAR (Veri Standartlaştırma)
// ==========================================
enum RoleLevel {
  PERSONEL
  KURUM
  MINTIKA
  BOLGE
  SISTEM
}

enum StudentStatus {
  AKTIF
  PASIF
}

enum AttendanceStatus {
  GELDI
  GELMEDI
  HASTA
  IZINLI
  GEC
}

enum ExamType {
  YAZILI
  DENEME
  KDU
}

enum QuestionType {
  NORMAL
  YENI_NESIL
}

enum TaskModuleType {
  YOKLAMA
  KITAP
  MUFREDAT
  PERFORMANS
  YOY
  DENEME
  KDU
  GENEL
}

enum TaskStatus {
  BEKLIYOR
  ISLEMDE
  TAMAMLANDI
  IPTAL
}

enum InspectionStatus {
  BEKLIYOR
  ISLEMDE
  GIDERILDI
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ==========================================
// MODÜLLER
// ==========================================

model User {
  id            String   @id @default(uuid())
  personelId    String?  @unique 
  username      String   @unique 
  email         String?
  password      String   
  fullName      String   
  
  roles         String[]  @default(["PERSONEL"]) 
  roleLevel     RoleLevel @default(PERSONEL)
  
  districtId    String?
  district      District? @relation("UserDistrict", fields: [districtId], references: [id])

  classId       String?
  class         Class?    @relation("UserClass", fields: [classId], references: [id], onDelete: SetNull)
  
  institutionId String?  
  institution   Institution? @relation("InstitutionUsers", fields: [institutionId], references: [id], onDelete: Cascade)

  managedInstitution Institution? @relation("InstitutionManager")
  managedDistrict    District?    @relation("DistrictManager")
  managedRegion      Region?      @relation("RegionManager")
  managedClassIds    String[] 

  sentRequests      ConnectionRequest[] @relation("SentRequests")
  receivedRequests  ConnectionRequest[] @relation("ReceivedRequests")
  inspections       Inspection[] 
  
  sentTasks         Task[] @relation("SentTasks")
  
  auditLogs         AuditLog[] 
  assignments       TaskAssignment[]

  @@index([institutionId])
}

model Institution {
  id        String   @id @default(uuid())
  name      String
  nevi      String   @default("ORTAOKUL")

  districtId String?
  district   District? @relation(fields: [districtId], references: [id])
  
  managerId  String?  @unique 
  manager    User?    @relation("InstitutionManager", fields: [managerId], references: [id], onDelete: SetNull)
  
  users      User[]   @relation("InstitutionUsers")
  classes    Class[]
  levels     LevelGroup[] 
  
  students         Student[]
  books            Book[]
  inspections      Inspection[]
  testBookTopics   TestBookTopic[]
  mockExamSettings MockExamSetting[]
  preExamSettings  PreExamSetting[]
}

model Class {
  id            String      @id @default(uuid())
  name          String      
  level         String      
  
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  
  users         User[]      @relation("UserClass")
  @@index([institutionId])
}

model LevelGroup {
  id            String   @id @default(uuid())
  name          String   
  
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  @@index([institutionId])
}

model Student {
  id            String   @id @default(uuid())
  institutionId String
  studentCode   String   @unique
  fullName      String
  orderIndex    Int      
  status        StudentStatus @default(AKTIF)

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  
  classId       String?
  levelGroupId  String?
  
  attendances   Attendance[]
  bookTrackings StudentBookTracking[]
  performances  Performance[]
  exams         Exam[]
  questions     QuestionTracking[]
  performanceGrades PerformanceGrade[]
  preExamResults PreExamResult[]
  mockExamResults MockExamResult[]
  testBookResults TestBookResult[]

  @@index([institutionId])
  @@index([classId])
}

model Attendance {
  id          String   @id @default(uuid())
  studentId   String
  date        DateTime @db.Date
  status      AttendanceStatus

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@unique([studentId, date])
  @@index([studentId, date])
}

model Book {
  id            String   @id @default(uuid())
  title         String
  totalPages    Int
  institutionId String?  
  
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  trackings     StudentBookTracking[]
}

model StudentBookTracking {
  id          String   @id @default(uuid())
  studentId   String
  bookId      String
  readPages   Int      @default(0)
  isCompleted Boolean  @default(false)
  logs        ReadingLog[]
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model ReadingLog {
  id          String   @id @default(uuid())
  trackingId  String   
  pagesRead   Int      
  date        DateTime @default(now())

  tracking    StudentBookTracking @relation(fields: [trackingId], references: [id], onDelete: Cascade)
}

model Performance {
  id              String   @id @default(uuid())
  studentId       String
  weekStartDate   DateTime @db.Date
  branchName      String
  score           Int      

  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Exam {
  id          String   @id @default(uuid())
  studentId   String
  examType    ExamType
  branchName  String
  targetScore Float
  actualScore Float?
  yoy1        Float?
  yoy2        Float?
  yoy3        Float?

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model QuestionTracking {
  id               String   @id @default(uuid())
  studentId        String
  branchName       String
  questionType     QuestionType
  date             DateTime @db.Date
  totalQuestions   Int
  correctAnswers   Int
  incorrectAnswers Int
  netScore         Float?

  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model PerformanceGrade {
  id            String   @id @default(uuid())
  studentId     String
  weekStartDate DateTime 
  subjectId     Int      
  score         Int      
  
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([studentId, weekStartDate, subjectId])
}

model WeeklyClassSetting {
  id            String   @id @default(uuid())
  institutionId String
  weekStartDate DateTime
  subjectId     Int      
  isCancelled   Boolean  @default(false)

  @@unique([institutionId, weekStartDate, subjectId])
}

model CurriculumSubject {
  id            String   @id @default(uuid())
  name          String   
  institutionId String   
  classId       String   @default("GENEL") 
  topics        CurriculumTopic[]
}

model CurriculumTopic {
  id            String   @id @default(uuid())
  subjectId     String
  title         String   
  weekLabel     String?  
  startDate     DateTime? 
  endDate       DateTime? 
  specialNotes  String?  
  orderIndex    Int      @default(0) 
  
  subject       CurriculumSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  progresses    TopicProgress[]
}

model TopicProgress {
  id            String   @id @default(uuid())
  topicId       String
  institutionId String   
  classId       String   @default("GENEL") 
  status        String   @default("ISLENMEDI")
  completedAt   DateTime? 
  
  topic         CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@unique([topicId, institutionId, classId])
}

model PreExamSetting {
  id            String   @id @default(uuid())
  institutionId String
  term          String
  subject       String
  practiceCount Int      @default(1)

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  @@unique([institutionId, term, subject])
}

model PreExamResult {
  id             String   @id @default(uuid())
  studentId      String
  term           String   
  subject        String   
  targetScore    Int?      
  actualScore    Int?      
  practiceScores String   @default("[]") 

  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([studentId, term, subject])
}

model MockExamSetting {
  id            String   @id @default(uuid())
  institutionId String
  examType      String   
  count         Int      @default(1) 

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  @@unique([institutionId, examType])
}

model MockExamResult {
  id            String   @id @default(uuid())
  studentId     String
  examType      String   
  examNumber    Int      
  turkce        Float?
  sosyal        Float?
  matematik     Float?
  ingilizce     Float?
  fen           Float?
  din           Float?
  score         Float?   

  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([studentId, examType, examNumber])
}

model TestBookTopic {
  id                  String   @id @default(uuid())
  institutionId       String   
  subject             String   
  title               String   
  normalQuestionCount Int      @default(0) 
  yeniNesilCount      Int      @default(0) 
  orderIndex          Int      @default(0)
  classId             String   @default("GENEL") 

  institution         Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  results             TestBookResult[]
  @@unique([institutionId, subject, title])
}

model TestBookResult {
  id              String   @id @default(uuid())
  studentId       String
  topicId         String
  normalDogru     Int?
  normalYanlis    Int?
  yeniNesilDogru  Int?
  yeniNesilYanlis Int?

  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic           TestBookTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@unique([studentId, topicId])
}

model Inspection {
  id             String   @id @default(uuid())
  institutionId  String   
  userId         String?  
  inspectorRole  String   
  inspectorName  String   
  inspectionDate DateTime 
  remarks        String   @db.Text 
  
  fixStatus      InspectionStatus @default(BEKLIYOR) 
  createdAt      DateTime @default(now())

  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user           User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model District {
  id            String        @id @default(uuid())
  name          String        
  regionId      String?
  region        Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)
  managerId     String?       @unique 
  manager       User?         @relation("DistrictManager", fields: [managerId], references: [id], onDelete: SetNull)
  institutions  Institution[]
  users         User[]        @relation("UserDistrict")
}

model Region {
  id        String     @id @default(uuid())
  name      String     
  managerId String?    @unique 
  manager   User?      @relation("RegionManager", fields: [managerId], references: [id], onDelete: SetNull)
  districts District[]
}

model ConnectionRequest {
  id          String   @id @default(uuid())
  senderId    String   
  receiverId  String   
  targetType  String   
  targetId    String   
  
  status      ConnectionStatus @default(PENDING) 
  createdAt   DateTime @default(now())

  sender      User     @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Task {
  id              String   @id @default(uuid())
  title           String   
  description     String?  @db.Text 
  status          TaskStatus @default(BEKLIYOR)
  moduleType      TaskModuleType?  
  isAutoTracked   Boolean  @default(false) 
  targetUrl       String?  
  month           Int?     // Geri eklendi
  week            Int?     // Geri eklendi
  deadline        DateTime? 
  
  institutionId   String?  
  senderId        String   
  
  assignments     TaskAssignment[] 
  proofs          TaskProof[]
  progressRecords TaskProgress[] 
  
  createdAt       DateTime @default(now())
  sender          User     @relation("SentTasks", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([institutionId, month, week])
}

model TaskProgress {
  id             String   @id @default(uuid())
  taskId         String
  userId         String   
  institutionId  String
  totalExpected  Int      
  completedCount Int      @default(0) 
  percentage     Float    @default(0) 
  
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAssignment {
  id            String   @id @default(uuid())
  taskId        String
  userId        String?  
  classId       String?  
  institutionId String?
  
  isCompleted   Boolean  @default(false)
  completedAt   DateTime?

  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model TaskProof {
  id          String   @id @default(uuid())
  taskId      String
  userId      String
  imageUrl    String?
  note        String?
  createdAt   DateTime @default(now())

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String   
  targetType  String   
  targetId    String   
  before      String?  @db.Text 
  after       String?  @db.Text 
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}